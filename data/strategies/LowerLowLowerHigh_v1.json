{
  "name": "LowerLowLowerHigh",
  "version": 1,
  "symbol": "XAUUSD",
  "timeframe": "H1",
  "direction": "SELL",
  "description": "SMC Market Structure: SELL when price forms Lower Low and Lower High.\nRule 1: current high < previous high (LH)\nRule 2: current low  < previous low  (LL)\nRule 3: current close < current open (bearish close confirms)",
  "conditions": {
    "operator": "AND",
    "rules": [
      {
        "left": {
          "type": "price",
          "field": "high",
          "period": 0
        },
        "operator": "<",
        "right": {
          "type": "price",
          "field": "high",
          "period": 1
        }
      },
      {
        "left": {
          "type": "price",
          "field": "low",
          "period": 0
        },
        "operator": "<",
        "right": {
          "type": "price",
          "field": "low",
          "period": 1
        }
      },
      {
        "left": {
          "type": "price",
          "field": "close",
          "period": 0
        },
        "operator": "<",
        "right": {
          "type": "price",
          "field": "open",
          "period": 0
        }
      }
    ]
  }
}